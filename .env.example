NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://director:director@localhost:5432/director
JWT_SECRET=dev-only-secret-change-me-min-32-characters

# AI Director (optional). Without AI_API_KEY the next-scene pick is deterministic.
# AI_API_KEY=sk-ant-...
# AI_WORKSPACE_ID=wrkspc_...   # only if AI_API_KEY is an identity-linked key
AI_MODEL=claude-opus-5
AI_TIMEOUT_MS=8000
WEATHER_TIMEOUT_MS=5000

# Places ingest (optional). Without KAKAO_REST_API_KEY /areas/:id/places/ingest is disabled.
# KAKAO_REST_API_KEY=...
PLACES_TIMEOUT_MS=5000
# Driving directions (optional). Kakao Mobility key; falls back to KAKAO_REST_API_KEY.
# Without either, driving scenes get no route.
# KAKAO_MOBILITY_API_KEY=...
DIRECTIONS_TIMEOUT_MS=5000
# ADMIN_TOKEN guards the admin endpoints (area create, place ingest); unset => disabled.
# ADMIN_TOKEN=...

# Photo storage. Set all four R2_* vars for Cloudflare R2 (private bucket;
# client uploads via presigned PUT, reads via presigned GET). Otherwise photos
# use the local filesystem + volume, served at MEDIA_BASE_URL (dev/test only).
# MEDIA_BASE_URL=https://director.jjinsol.com/media
PHOTO_MAX_BYTES=8388608
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=director-media
